{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick",
  "description": "快捷查找窗口能力：本地存储、HTTP 请求（翻译/词典）与事件监听；窗口显示/隐藏/聚焦由 Rust 自定义命令 show_quick/hide_quick 完成，不授窗口权限",
  "windows": [
    "quick"
  ],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    }
  ]
}
